server {
    listen 80;
    server_tokens off;
    client_max_body_size 32m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_min_length 1024;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Hub-Token "";
    proxy_set_header X-Hub-User "";
    proxy_read_timeout 180s;

    location = /healthz { proxy_pass http://pan:5000/healthz; }
    location ^~ /internal/ { return 404; }
    location = /__hub_auth {
        internal;
        proxy_pass http://pan:5000/internal/hub-auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Hub-Token "${HUB_SHARED_SECRET}";
    }
    location = /media-engine { return 302 /media-engine/; }
    location /media-engine/ {
        auth_request /__hub_auth;
        auth_request_set $hub_user $upstream_http_x_hub_user;
        proxy_set_header X-Hub-Token "${HUB_SHARED_SECRET}";
        proxy_set_header X-Hub-User $hub_user;
        proxy_set_header Host $http_host;
        proxy_pass http://media:3000/;
        error_page 401 403 = @hub_login;
    }
    location = /dirlist {
        auth_request /__hub_auth;
        auth_request_set $hub_user $upstream_http_x_hub_user;
        proxy_set_header X-Hub-Token "${HUB_SHARED_SECRET}";
        proxy_set_header X-Hub-User $hub_user;
        proxy_pass http://media:3000;
    }
    location ^~ /api/v1/ {
        auth_request /__hub_auth;
        auth_request_set $hub_user $upstream_http_x_hub_user;
        proxy_set_header X-Hub-Token "${HUB_SHARED_SECRET}";
        proxy_set_header X-Hub-User $hub_user;
        proxy_pass http://media:3000;
    }
    location ^~ /static/ {
        proxy_pass http://media:3000;
        expires 1h;
    }
    location = /project-source.zip {
        alias /usr/share/nginx/html/project-source.zip;
        add_header Content-Disposition 'attachment; filename="Film-Index-Hub-source.zip"';
    }
    location ^~ /api/task/stream/ {
        proxy_pass http://pan:5000;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }
    location ^~ /assets/ {
        proxy_pass http://pan:5000;
        expires 30d;
        add_header Cache-Control 'public, immutable';
    }
    location @hub_login {
        default_type text/html;
        return 401 '<!doctype html><meta charset="utf-8"><p>登录已过期，正在返回统一登录页面</p><script>window.top.location.replace("/login")</script>';
    }
    location / { proxy_pass http://pan:5000; }
}
