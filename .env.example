# Existing Baidu config folder: must contain config.json, not the project root.
PAN_CONFIG_DIR=./data/pan/config
PAN_LOG_DIR=./data/pan/log
# Existing Film Index config folder: must contain config.yaml and its database.
MEDIA_CONFIG_DIR=./data/media
# Map the same media parent folder previously used by Film Index.
MEDIA_ROOT=./media
PAN_MEMORY=384m
MEDIA_MEMORY=384m
