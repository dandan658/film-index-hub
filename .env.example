# Set these to the real existing NAS host directories before migration.
# PAN_CONFIG_DIR must contain config.json and history/.
# MEDIA_CONFIG_DIR must contain config.yaml and the media databases.
PAN_CONFIG_DIR=./data/config
PAN_LOG_DIR=./data/log
MEDIA_CONFIG_DIR=./data/media
MEDIA_ROOT=./media
FILM_MEMORY=512m

